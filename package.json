{
  "name": "mobie-hackathon-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js starter for the mobie Voice AI Challenge: Auth0 PKCE, REST API and Mapbox geocoding",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/main.js",
    "start:prod": "node --env-file=.env dist/main.js",
    "dev": "tsx --env-file=.env watch src/main.ts",
    "lint": "eslint src test",
    "test": "node --import tsx --test test/*.test.ts",
    "test:build": "npm run build && npm test",
    "example:search": "node --env-file=.env examples/search.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "^12.1.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
