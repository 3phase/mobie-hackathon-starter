# Public staging configuration supplied by mobie. Never use a production account.
MOBIE_API_URL=https://api-staging.mobie.at
AUTH0_DOMAIN=YOUR_STAGING_TENANT.eu.auth0.com
AUTH0_CLIENT_ID=YOUR_HACKATHON_CLIENT_ID
AUTH0_AUDIENCE=https://api-staging.mobie.at
# Register this exact URL as an Auth0 Allowed Callback URL.
AUTH0_REDIRECT_URI=http://localhost:3000/callback
PORT=3000
HOST=127.0.0.1
# Generated by npm run setup. Protects the starter, NOT the mobie API.
STARTER_API_KEY=
# Each team supplies its own token. Uses Geocoding v6 permanent=true.
MAPBOX_ACCESS_TOKEN=
# OpenPLZ defaults are suitable for local development; override only when needed.
OPENPLZ_BASE_URL=https://openplzapi.org
OPENPLZ_CACHE_TTL_MS=86400000
OPENPLZ_CACHE_MAX_ENTRIES=100
OPENPLZ_TIMEOUT_MS=8000
OPENPLZ_RETRIES=2
