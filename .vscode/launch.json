{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug NestJS",
      "runtimeVersion": "24",
      "program": "${workspaceFolder}/src/main.ts",
      "runtimeArgs": ["--env-file=.env", "--import", "tsx", "--watch"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
